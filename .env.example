NAVER_INCHEON_CUSTOMER_ID=
NAVER_INCHEON_ACCESS_LICENSE=
NAVER_INCHEON_SECRET_KEY=
# The existing Railway /data volume keeps reports across deployments.
NAVER_ADS_DB_PATH=/data/naver-ads.db
NAVER_ADS_SYNC_ENABLED=true
# Optional, for local use only. Railway uses service variables.
# NAVER_ADS_ENV_FILE=/absolute/path/to/existing/.env

# Browser key for Kakao Maps. Register the deployed origin in Kakao Developers.
KAKAO_JAVASCRIPT_KEY=

# Daily 09:00 KST public news RSS collection, stored in the existing /data volume.
COMPETITOR_NEWS_DB_PATH=/data/competitor-news.db
COMPETITOR_NEWS_SYNC_ENABLED=true

# Wiki chat. Keys are server-only; never include them in HTML or Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CHAT_ADMIN_TOKEN=
WIKI_DB_PATH=/data/wiki-chat.db
CHAT_DAILY_LIMIT=300

# Daily 09:10 KST, the nine public NHIS/MOHW boards requested for care operations.
AGENCY_NEWS_DB_PATH=/data/agency-news.db
AGENCY_NEWS_SYNC_ENABLED=true
# Optional server-only JSON overrides for support matching (industry, employment,
# revenue and certifications). Do not put actual financial/employment data in Git.
BUSINESS_SUPPORT_PROFILE_JSON=

# Daily 10:50 KST search visibility. Existing OpenAI key is reused server-side.
SEARCH_VISIBILITY_DB_PATH=/data/search-visibility.db
SEARCH_VISIBILITY_SYNC_ENABLED=true
SEARCH_VISIBILITY_MAX_PAGES=5
SEARCH_VISIBILITY_AI_LIMIT=6
# Astra uses low reasoning, up to 4,096 output tokens and 3 web-search tool calls.
SEARCH_OPENAI_MODEL=gpt-6-astra
SEARCH_GEMINI_MODEL=gemini-3.6-flash
SEARCH_PERPLEXITY_MODEL=sonar
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
# Optional Naver SERP provider; uses a separate provider account and quota.
SERPAPI_KEY=
# Optional JSON override for aliases, owned URLs and AI questions. No API keys here.
SEARCH_VISIBILITY_CONFIG_JSON=

# Daily public reputation screening; reuses OPENAI_API_KEY for source-only classification.
REPUTATION_DB_PATH=/data/reputation-watch.db
REPUTATION_SYNC_ENABLED=true
REPUTATION_MODEL=gpt-4.1-mini

# Private, single-operator support application workspace. Keep actual keys out of Git.
SUPPORT_ACCESS_KEY=
SUPPORT_DB_PATH=/data/support-applications.db
SUPPORT_WORKER_ENABLED=true
SUPPORT_OPENAI_MODEL=gpt-4.1-mini
SUPPORT_DAILY_DRAFT_LIMIT=30
